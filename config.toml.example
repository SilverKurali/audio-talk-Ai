[voice]
enabled = true
mode = "toggle"
push_to_talk = "F9"
language = "zh-CN"
auto_submit = true
# 输入设备：留空用系统默认。WebUI/TUI 可枚举并选择具体设备，例如：
#   Windows (ffmpeg dshow): 麦克风 (Realtek(R) Audio)
#   Linux   (arecord):      hw:1,0 / plughw:1,0
#   macOS   (CoreAudio):    MacBook 麦克风
# device = ""
# hotwords = ["术语1", "术语2"]

# 向后兼容：不配置 [[asr_providers]] 时，直接在 [voice] 中写 app_key/access_key 也能用
# app_key = "your_app_key"
# access_key = "your_access_key"

# ── 多 provider 配置 ──

# 豆包 ASR（流式，推荐）
[[asr_providers]]
name = "doubao"
type = "doubao"
default = true
app_key = "your_app_key"
access_key = "your_access_key"

# OpenAI Realtime（流式，WebSocket）
# 模型：gpt-4o-transcribe / gpt-4o-mini-transcribe / whisper-1
# [[asr_providers]]
# name = "openai"
# type = "openai-realtime"
# api_key = "sk-..."
# model = "gpt-4o-mini-transcribe"

# OpenAI Whisper（批量，录完后识别）
# [[asr_providers]]
# name = "whisper"
# type = "openai-whisper"
# api_key = "sk-..."
# model = "whisper-1"

# 兼容 OpenAI 格式的第三方服务（如 Ollama、vLLM 等）
# [[asr_providers]]
# name = "local-whisper"
# type = "openai-whisper"
# api_key = "ollama"
# model = "whisper"
# endpoint = "http://localhost:11434/v1/audio/transcriptions"

# 讯飞星火语音识别大模型（流式，WebSocket）
# 获取密钥：https://console.xfyun.cn/services/bmc
# [[asr_providers]]
# name = "xfyun"
# type = "xfyun-spark"
# app_id = "your_app_id"
# api_key = "your_api_key"
# api_secret = "your_api_secret"
# dwa = "wpgs"  # 动态修正：留空关闭，"wpgs" 开启

# 讯飞语音听写（流式版）（流式，WebSocket，支持垂直领域和多方言免切）
# 获取密钥：https://console.xfyun.cn/services/iat
# [[asr_providers]]
# name = "xfyun-iat"
# type = "xfyun-iat"
# app_id = "your_app_id"
# api_key = "your_api_key"
# api_secret = "your_api_secret"
# domain = "iat"  # 可选：iat/medical/gov-seat-assistant/seat-assistant 等
# accent = "mandarin"  # 普通话，或 xfime-mianqie 方言免切
# dwa = "wpgs"  # 动态修正：留空关闭，"wpgs" 开启

# 讯飞实时语音转写大模型（流式，WebSocket + Binary PCM，支持最长 8 小时）
# 获取密钥：https://console.xfyun.cn/services/rtasr
# [[asr_providers]]
# name = "xfyun-rtasr"
# type = "xfyun-rtasr"
# app_id = "your_app_id"
# api_key = "your_access_key_id"  # AccessKeyId
# api_secret = "your_access_key_secret"  # AccessKeySecret
# lang = "autodialect"  # autodialect=中英+方言，autominor=多语种
# pd = ""  # 可选：court/edu/finance/medical/tech/sport/gov 等

# 讯飞实时语音转写标准版（流式，WebSocket + Binary PCM，最长 5 小时）
# 获取密钥：https://console.xfyun.cn/services/lfasr （语音转写服务页）
# [[asr_providers]]
# name = "xfyun-rtasr-std"
# type = "xfyun-rtasr-std"
# app_id = "your_app_id"
# api_key = "your_api_key"  # API Key（不是 AccessKeyId）
# lang = "cn"  # cn=中文，en=英文
# pd = ""  # 可选：court/edu/finance/medical/tech/sport/gov 等

# 讯飞录音文件转写（标准版）（批量，录完后上传识别）
# 获取密钥：https://console.xfyun.cn/services/lfasr
# [[asr_providers]]
# name = "xfyun-lfasr"
# type = "xfyun-lfasr"
# app_id = "your_app_id"
# api_key = "your_api_key"
# api_secret = "your_secret_key"  # 注意是 SecretKey，不是 APISecret
# pd = ""  # 可选：court/edu/finance/medical/tech/sport/gov 等

# 讯飞录音文件转写大模型（批量，支持 202 种方言免切）
# 获取密钥：https://console.xfyun.cn/services/lfasr_llm
# [[asr_providers]]
# name = "xfyun-llm"
# type = "xfyun-lfasr-llm"
# app_id = "your_app_id"
# api_key = "your_access_key_id"  # AccessKeyId
# api_secret = "your_access_key_secret"  # AccessKeySecret
# pd = ""  # 可选：court/edu/finance/medical/tech/sport/gov 等

# 讯飞极速录音转写大模型（批量，1小时音频约20秒出结果）
# 获取密钥：https://console.xfyun.cn/services/ost
# [[asr_providers]]
# name = "xfyun-fast"
# type = "xfyun-lfasr-fast"
# app_id = "your_app_id"
# api_key = "your_api_key"
# api_secret = "your_api_secret"
# pd = ""  # 可选：court/edu/finance/medical/tech/sport/gov 等

# 小米 MiMo ASR（批量，录完后识别）
# 获取密钥：https://platform.xiaomimimo.com/console
# [[asr_providers]]
# name = "mimo"
# type = "xiaomi-mimo-asr"
# api_key = "your_mimo_api_key"
# model = "mimo-v2.5-asr"

# 小米 MiMo ASR Token Plan（批量，国内节点）
# [[asr_providers]]
# name = "mimo-token"
# type = "xiaomi-mimo-asr-TokenPlan"
# api_key = "your_mimo_api_key"
# model = "mimo-v2.5-asr"

[overlay]
enabled = true
position = "bottom-center"

# Web 管理界面（浏览器访问配置和历史记录）
[web]
enabled = true
port = 8391        # 浏览器访问 http://localhost:8391
